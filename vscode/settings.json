{
	// code spell checker
	"cSpell.enabled": true,
	"cSpell.language": "en,ru",
	"cSpell.enabledFileTypes": {
		"*": true,
		"markdown": true,
		"jsx": true,
		"tsx": true,
		"ts": true,
		"js": true,
		"css": true,
		"scss": true,
		"sass": true,
		"svelte": true,
		"yaml": true,
		"yml": true
	},

	// Git
	"git.enableSmartCommit": true,

	// Исключаемые файлы
	"files.exclude": {
		"**/.git": true,
		"**/.svn": true,
		"**/.hg": true,
		"**/CVS": true,
		"**/.DS_Store": true,
		"**/Thumbs.db": true,
		"**/.idea": true,
		"**/node_modules": true,
		"**/.next": true
	},

	// Auto save
	"files.autoSave": "afterDelay",

	// Шрифт
	"editor.fontSize": 15,
	"editor.fontFamily": "'0xProto Nerd Font Mono', Menlo, Monaco, 'Courier New', monospace",
	"editor.fontLigatures": true,
	"editor.fontWeight": "400",
	"editor.lineHeight": 1.5,
	"chat.editor.fontFamily": "'0xProto Nerd Font Mono'",
	"editor.codeLensFontFamily": "'0xProto Nerd Font Mono'",
	"debug.console.fontFamily": "'0xProto Nerd Font Mono'",

	// Disabled breadcrumbs
	"breadcrumbs.icons": false,
	"breadcrumbs.showKeys": false,
	"breadcrumbs.showFiles": false,
	"breadcrumbs.symbolPath": "off",
	"breadcrumbs.showArrays": false,
	"breadcrumbs.showBooleans": false,
	"breadcrumbs.showClasses": false,
	"breadcrumbs.showConstants": false,
	"breadcrumbs.showConstructors": false,
	"breadcrumbs.showEnumMembers": false,
	"breadcrumbs.showEvents": false,
	"breadcrumbs.showFields": false,
	"breadcrumbs.showEnums": false,
	"breadcrumbs.showFunctions": false,
	"breadcrumbs.showInterfaces": false,
	"breadcrumbs.showMethods": false,
	"breadcrumbs.showModules": false,
	"breadcrumbs.showNamespaces": false,
	"breadcrumbs.showNull": false,
	"breadcrumbs.showNumbers": false,
	"breadcrumbs.showObjects": false,
	"breadcrumbs.showOperators": false,
	"breadcrumbs.showPackages": false,
	"breadcrumbs.showProperties": false,
	"breadcrumbs.showStrings": false,
	"breadcrumbs.showStructs": false,
	"breadcrumbs.showTypeParameters": false,
	"breadcrumbs.showVariables": false,

	// Disabled mini-map
	"editor.minimap.renderCharacters": false,
	"editor.minimap.enabled": false,

	// Настройки терминала
	"terminal.integrated.fontSize": 16,

	// Prettier
	"editor.formatOnPaste": true,
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"prettier.trailingComma": "none",
	"prettier.tabWidth": 2,
	"prettier.printWidth": 120,
	"prettier.useTabs": true,
	"prettier.semi": true,
	"prettier.singleQuote": true,
	"prettier.jsxSingleQuote": true,
	"prettier.arrowParens": "avoid",
	"prettier.quoteProps": "consistent",
	"prettier.bracketSameLine": false,
	"prettier.bracketSpacing": true,
	"prettier.endOfLine": "auto",
	"prettier.singleAttributePerLine": true,
	"editor.codeActionsOnSave": {
		"source.organizeImports": "explicit",
		"source.fixAll.eslint": "explicit",
		"source.removeUnusedImports": "always"
	},
	"editor.inlineSuggest.enabled": true,

	// Настройки js и ts
	"javascript.updateImportsOnFileMove.enabled": "always",
	"typescript.updateImportsOnFileMove.enabled": "always",
	"javascript.preferences.quoteStyle": "single",
	"typescript.preferences.quoteStyle": "single",
	"javascript.format.semicolons": "remove",
	"typescript.format.semicolons": "remove",
	"js/ts.implicitProjectConfig.experimentalDecorators": true,

	// Настройки eslint
	"eslint.workingDirectories": [{ "mode": "auto" }],
	"eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "vue", "svelte"],
	"eslint.nodePath": "./node_modules",
	"eslint.enable": true,
	"eslint.options": {
		"overrideConfigFile": "./eslint.config.ts"
	},

	// Настройки темы
	"workbench.iconTheme": "catppuccin-mocha",
	"workbench.colorTheme": "Catppuccin Mocha",

	// Исправление багов vscode
	"emmet.includeLanguages": {
		"javascript": "javascriptreact",
		"typescript": "typescriptreact"
	},
	"emmet.triggerExpansionOnTab": true,
	"http.proxySupport": "fallback",

	// Перенос слов
	"editor.wordWrap": "bounded",
	"editor.wrappingIndent": "same",
	"editor.wordWrapColumn": 120,

	// Автоматическое закрытие тегов
	"html.autoClosingTags": true,
	"javascript.autoClosingTags": true,
	"typescript.autoClosingTags": true,

	// Отображение символов
	"editor.renderControlCharacters": false,
	"editor.unicodeHighlight.ambiguousCharacters": false,

	// Ускоряем открытие подсказок
	"editor.quickSuggestionsDelay": 0,
	"html.completion.attributeDefaultValue": "singlequotes",

	// Внешний вид редактора
	"editor.glyphMargin": false,
	"editor.bracketPairColorization.enabled": true,
	"editor.scrollbar.horizontal": "hidden",
	"editor.scrollbar.vertical": "hidden",
	"window.density.editorTabHeight": "default",
	"editor.accessibilitySupport": "off",
	"workbench.editor.empty.hint": "hidden",
	"workbench.sideBar.location": "right",
	"workbench.activityBar.location": "hidden",

	// Настройки обозревателя
	"explorer.confirmDelete": false,
	"explorer.confirmDragAndDrop": false,
	"workbench.editor.tabSizing": "shrink",
	"window.commandCenter": false,
	"workbench.layoutControl.enabled": false,

	// Настройки редактора
	"window.openFilesInNewWindow": "off",
	"editor.folding": false,
	"editor.insertSpaces": false,
	"editor.suggestSelection": "first",
	"editor.formatOnSave": true,
	"editor.lineNumbers": "relative",
	"editor.cursorSmoothCaretAnimation": "explicit",
	"editor.tabSize": 2, // размер таба
	"explorer.compactFolders": false, // компактные папки
	"editor.smoothScrolling": true, // плавный скролл
	"workbench.list.smoothScrolling": true, // плавный скролл
	"terminal.integrated.smoothScrolling": true, // плавный скролл в терминале
	"editor.cursorBlinking": "expand", // мигающей курсор
	"terminal.integrated.cursorBlinking": true, // мигающей курсор
	"editor.linkedEditing": true,

	// Настройка vim
	"vim.normalModeKeyBindingsNonRecursive": [
		{
			"before": ["d", "w"],
			"after": ["v", "b", "d"]
		}
	],

	// Прочие настройки
	"security.workspace.trust.untrustedFiles": "open",
	"editor.gotoLocation.multipleDefinitions": "goto",
	"editor.stickyScroll.scrollWithEditor": false,
	"workbench.tree.enableStickyScroll": false,
	"window.zoomLevel": 0.8,
	"git.autofetch": true,
	"git.confirmSync": false,
	"github.copilot.advanced": {
		"authProvider": "github"
	},
	"docker.extension.enableComposeLanguageServer": false,
	"makefile.configureOnOpen": false,
	"explorer.confirmPasteNative": false,
	"cSpell.userWords": [
		"Buildx",
		"FHCM",
		"FRUTHS",
		"GMAO",
		"hhid",
		"HHRU",
		"KCHBE",
		"Koneshov",
		"MGQRO",
		"MMLEO",
		"NEXTAUTH",
		"nextjs",
		"sotrudniki",
		"trls",
		"ttgis",
		"VPME"
	],
	"json.schemas": [
		{
			"fileMatch": [".prettierrc", ".prettierrc.json"],
			"url": "file:///Users/sssed/Downloads/prettierrc"
		}
	],
	"json.validate.enable": false,
	"yaml.schemas": {
		"file:///Users/sssed/.vscode/extensions/continue.continue-1.2.10-darwin-arm64/config-yaml-schema.json": [
			".continue/**/*.yaml"
		]
	},
	"svelte.enable-ts-plugin": true,
	"[prisma]": {
		"editor.defaultFormatter": "Prisma.prisma"
	},
	"[svelte]": {
		"editor.defaultFormatter": "svelte.svelte-vscode"
	},
	"errorLens.enabled": true,
	"errorLens.editorHoverPartsEnabled": {
		"messageEnabled": true
	}
}
